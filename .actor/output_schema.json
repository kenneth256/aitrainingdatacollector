{
  "title": "AI Training Data",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "record_id": {
      "type": "string",
      "title": "ID",
      "description": "Unique identifier",
      "editor": "textfield"
    },
    "source": {
      "type": "string",
      "title": "Platform",
      "description": "Source platform",
      "editor": "select",
      "enum": ["reddit", "hackernews", "twitter", "news"]
    },
    "keyword": {
      "type": "string",
      "title": "Keyword",
      "description": "Search keyword used",
      "editor": "textfield"
    },
    "content_type": {
      "type": "string",
      "title": "Content Type",
      "description": "Type of content",
      "editor": "select",
      "enum": ["text", "text_image"]
    },
    "url": {
      "type": "string",
      "title": "URL",
      "description": "Source URL",
      "editor": "textfield"
    },
    "text": {
      "type": "object",
      "title": "Text Content",
      "description": "Extracted text",
      "editor": "json"
    },
    "media": {
      "type": "object",
      "title": "Media",
      "description": "Images and other media",
      "editor": "json"
    },
    "metadata": {
      "type": "object",
      "title": "Metadata",
      "description": "Platform-specific metadata",
      "editor": "json"
    },
    "scraped_at": {
      "type": "string",
      "title": "Scraped At",
      "description": "Timestamp when scraped",
      "editor": "textfield"
    }
  }
}