{
    "actorSpecification": 1,
    "name": "ai-training-data-collector",
    "title": "AI Training Data Collector",
    "description": "Collects AI-related content from multiple sources for training data",
    "version": "0.0.1",
    "meta": {
        "templateId": "js-start"
    },
    "input": "./input_schema.json",
    "dockerfile": "./Dockerfile",
    "readme": "./README.md",
    "categories": ["SCRAPER"],
    "defaultRunOptions": {
        "build": "latest",
        "timeoutSecs": 3600,
        "memoryMbytes": 4096
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "fields": {
                "id": {
                    "type": "string",
                    "title": "ID"
                },
                "source": {
                    "type": "string",
                    "title": "Platform"
                },
                "keyword": {
                    "type": "string",
                    "title": "Keyword"
                },
                "content_type": {
                    "type": "string",
                    "title": "Type"
                },
                "url": {
                    "type": "string",
                    "title": "URL"
                },
                "text": {
                    "type": "object",
                    "title": "Text Content"
                },
                "scraped_at": {
                    "type": "string",
                    "title": "Scraped At"
                }
            }
        }
    }
}